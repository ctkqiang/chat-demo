# 环境变量示例：构建期读取，需在运行 pnpm dev / pnpm build 前导出到 shell。
# 复制为 .env 不会自动生效（本项目不读取 .env 文件，也没有加载 dotenv）。
# 例如：export LIVE_VOICE_REALTIME_URL="wss://example.com/v1/realtime"

# 实时语音服务地址（预留，可选）。
# 留空时 Live 语音使用级联链路（ASR → LLM → TTS），无需任何后端。
# 配置后，构建产物会通过 __LIVE_VOICE_REALTIME_URL__ 注入该地址；
# 由于当前构建未包含实时语音适配器实现，开启 Live 语音会明确报错，
# 而不是把级联链路伪装成全双工。接入真实服务时见 docs/live-voice.md。
LIVE_VOICE_REALTIME_URL=
